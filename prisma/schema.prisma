generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model QuoteRequest {
  id        String   @id @default(cuid())
  pickup    String
  dropoff   String
  date      String
  pax       Int
  vehicleId String
  name      String
  email     String
  phone     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}
